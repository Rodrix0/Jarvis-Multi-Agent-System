GEMINI_API_KEY=tu_api_key_aqui
PORT=3000

# Ciudad inicial para el clima. Al decir "estoy en <lugar>", Jarvis guarda la nueva ubicación.
JARVIS_WEATHER_CITY=Corrientes Capital, Argentina
# PIN opcional: si no se define, se usa el PIN de data/security.json.
# JARVIS_SECURITY_PIN=tu_pin_de_4_digitos

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# Variables que utiliza Jarvis en el Backend:
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu_anon_key_o_service_key_aqui
SUPABASE_TABLE_PERSONAL=tasks
SUPABASE_TABLE_GROUP=group_tasks

# Clave gratuita de VirusTotal para análisis con 70+ motores antivirus (opcional):
VIRUSTOTAL_API_KEY=tu_api_key_aqui

# Voz local M3: motor sin VoiceStudio; termina al completar cada respuesta.
# Requiere el SDK y los pesos Supertonic 3 instalados y su licencia aceptada.
JARVIS_TTS_ENGINE=supertonic3
# Para volver a System.Speech: JARVIS_TTS_ENGINE=windows
# Opcionales si se mueve la instalación (rutas absolutas):
# JARVIS_SUPERTONIC_PYTHON=C:/ruta/.venv/Scripts/python.exe
# JARVIS_SUPERTONIC_MODEL_DIR=C:/ruta/snapshot-supertonic-3
